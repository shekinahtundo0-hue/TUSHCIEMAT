# Copy to .env (gitignored) and fill in. Never put these values in the web app.
PORT=8080

# Runtime connection as the dedicated, non-superuser `tushciemat_api` role (RLS applies).
# Locally, `pnpm run dev:db` prints a ready-made value.
DATABASE_URL=
DATABASE_POOL_MAX=10
# PEM of the database CA (Supabase: Project Settings > Database > SSL). Use \n for newlines.
DATABASE_CA_CERT=

# Owner connection, used only by `pnpm --filter @workspace/db run migrate`. Not read by the API.
MIGRATION_DATABASE_URL=

# Firebase project id; ID tokens are verified against Google's public keys, no service-account secret needed.
FIREBASE_PROJECT_ID=

# Comma-separated browser origins allowed to call the API (not needed when the web app proxies /api).
CORS_ALLOWED_ORIGINS=
# Number of reverse-proxy hops in front of the API (defaults to 1 in production), or false.
TRUST_PROXY=
APP_TIMEZONE=Africa/Nairobi
INVITATION_TTL_DAYS=7
LOG_LEVEL=info

# Port for the local embedded Postgres started by `pnpm run dev:db`.
DEV_DB_PORT=54329
