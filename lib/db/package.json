    "check": "drizzle-kit check --config ./drizzle.config.ts",
    "migrate": "tsx ./scripts/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:"
  }
}
